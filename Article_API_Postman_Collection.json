{
  "info": {
    "name": "Article API",
    "description": "Collection Postman cho API quản lý bài viết (Articles)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "articleId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Article Management",
      "item": [
        {
          "name": "Get All Articles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/articles?page=1&limit=10&sortBy=publishedAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "publishedAt"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                }
              ]
            },
            "description": "Lấy danh sách tất cả bài viết với pagination"
          },
          "response": []
        },
        {
          "name": "Search Articles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/articles?search=test&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"],
              "query": [
                {
                  "key": "search",
                  "value": "test"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Tìm kiếm bài viết theo title và content"
          },
          "response": []
        },
        {
          "name": "Get Article by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const responseJson = pm.response.json();",
                  "    if (responseJson.data && responseJson.data._id) {",
                  "        pm.collectionVariables.set('articleId', responseJson.data._id);",
                  "        console.log('Article ID saved to collection variable');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/articles/{{articleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "{{articleId}}"]
            },
            "description": "Lấy chi tiết bài viết theo ID"
          },
          "response": []
        },
        {
          "name": "Create Article (Admin/TNV)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Tiêu đề bài viết mới",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "Nội dung bài viết chi tiết...",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            },
            "description": "Tạo bài viết mới với hình ảnh (chỉ ADMIN, TNV_CN, TNV_TC)"
          },
          "response": []
        },
        {
          "name": "Update Article",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Tiêu đề bài viết đã chỉnh sửa",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "Nội dung bài viết đã được cập nhật...",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/articles/{{articleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "{{articleId}}"]
            },
            "description": "Cập nhật bài viết với hình ảnh mới (chỉ tác giả hoặc admin)"
          },
          "response": []
        },
        {
          "name": "Delete Article",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/articles/{{articleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "{{articleId}}"]
            },
            "description": "Xóa bài viết (chỉ tác giả hoặc admin)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Image Management",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/articles/upload-image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "upload-image"]
            },
            "description": "Upload hình ảnh riêng lẻ lên S3"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Like Management",
      "item": [
        {
          "name": "Like Article",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/articles/{{articleId}}/like",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "{{articleId}}", "like"]
            },
            "description": "Thích/bỏ thích bài viết"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Test Cases",
      "item": [
        {
          "name": "Create Article - Missing Title",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "content",
                  "value": "Nội dung bài viết không có tiêu đề",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            },
            "description": "Test case: Tạo bài viết thiếu tiêu đề"
          },
          "response": []
        },
        {
          "name": "Create Article - No Auth",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Bài viết không có auth",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "Nội dung bài viết",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            },
            "description": "Test case: Tạo bài viết không có token xác thực"
          },
          "response": []
        },
        {
          "name": "Create Article - User Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Bài viết từ user thường",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "Nội dung bài viết",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            },
            "description": "Test case: Tạo bài viết với role USER (sẽ bị từ chối)"
          },
          "response": []
        },
        {
          "name": "Get Article - Invalid ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/articles/invalid-id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "invalid-id"]
            },
            "description": "Test case: Lấy bài viết với ID không hợp lệ"
          },
          "response": []
        },
        {
          "name": "Like Article - No Auth",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/articles/{{articleId}}/like",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "{{articleId}}", "like"]
            },
            "description": "Test case: Thích bài viết không có token xác thực"
          },
          "response": []
        },
        {
          "name": "Upload Image - No Auth",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/articles/upload-image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "upload-image"]
            },
            "description": "Test case: Upload hình ảnh không có token xác thực"
          },
          "response": []
        }
      ]
    }
  ]
}
